# ---- Arc testnet (public values) ----
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ---- Secrets (testnet-only keys; never reuse elsewhere, never commit) ----
# Deploys the vault and funds pots in the e2e script.
DEPLOYER_PRIVATE_KEY=
# Signs outcomes and submits resolve(); used only by the relay.
RESOLVER_PRIVATE_KEY=

# ---- Contract ----
# Grace period after a pot's deadline before expire() is allowed (seconds).
GRACE_PERIOD_SECONDS=3600
