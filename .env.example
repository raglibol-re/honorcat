# ---- Arc testnet (public values) ----
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ---- Secrets (testnet-only keys; never reuse elsewhere, never commit) ----
# Deploys the vault and funds pots in the e2e script.
DEPLOYER_PRIVATE_KEY=
# Signs outcomes and submits resolve(); used only by the relay.
RELAY_PRIVATE_KEY=

# ---- Contract ----
# Grace period after a pot's deadline before expire() is allowed (seconds).
GRACE_PERIOD_SECONDS=3600

# ---- Relay (server-side; on Vercel set these as project env vars, never NEXT_PUBLIC_) ----
# Postgres connection string (Neon via Vercel Marketplace sets DATABASE_URL automatically).
# Leave empty locally to use an embedded PGlite database in .data/pglite.
DATABASE_URL=
# Deployed vault (also read from deployments/5042002.json locally).
VAULT_ADDRESS=
VAULT_DEPLOY_BLOCK=
# Bearer token for /api/admin/* (manual outcomes, integrations). Long random string.
ADMIN_TOKEN=
# Bearer token Vercel Cron sends to /api/cron/tick. Long random string.
CRON_SECRET=
# rpc = poll logs over RPC on every tick (default); streams = rely on QuickNode Streams webhook.
INDEXER_PRIMARY=rpc
# Security token of the QuickNode Stream (for webhook HMAC verification).
QUICKNODE_STREAMS_TOKEN=
# Minimum milliseconds between opportunistic relay ticks.
TICK_MIN_INTERVAL_MS=4000
# Gasless relaying (EIP-3009): smallest sponsored amount (USDC) and per-payer hourly limit.
GASLESS_MIN_AMOUNT=0.10
GASLESS_MAX_PER_HOUR=10
# /status warns when the resolver holds less USDC than this.
RELAY_LOW_BALANCE_USDC=1

# Verdict Guarantees contracts (deployments/<chainId>.guarantees.json locally).
GUARANTEE_BOOK_ADDRESS=
BATCH_GUARD_ADDRESS=
GUARANTEES_DEPLOY_BLOCK=
PASSKEY_FACTORY_ADDRESS=
# The samplers' 2-of-3 resolver and the sampler addresses (defaults: deployments/<chain>.samplers.json)
RESOLVER_ADDRESS=
SAMPLERS=

# GrokCat (docs/grokcat-spec.md): xAI API key, server side only. Never NEXT_PUBLIC_, never logged.
# Without it GrokCat is shown asleep and everything else works.
XAI_API_KEY=
